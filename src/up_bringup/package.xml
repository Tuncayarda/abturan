<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>up_bringup</name>
  <version>0.0.0</version>
  <description>Robot bringup launch files for the Raspberry Pi 5 build (rosbridge, camera control, IMU, joystick/thruster control, STM32 actuator link)</description>
  <maintainer email="zeybekyasin13@gmail.com">pi</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rosapi</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>rpi_cam_bridge</exec_depend>
  <exec_depend>joy_motor_pkg</exec_depend>
  <exec_depend>stm32_bridge</exec_depend>
  <exec_depend>imu_bridge</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
